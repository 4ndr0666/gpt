{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://4ndr0neering.invalid/schemas/4ndr0-alignment.schema.json",
  "title": "Argon File-Anchored Bidirectional Alignment Schema",
  "type": "object",
  "required": ["declarations", "observations"],
  "additionalProperties": false,
  "properties": {
    "zero_dependency_rationale": { "type": "string", "minLength": 1 },
    "scope_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "consumer",
          "declaration_evidence",
          "provider_evidence",
          "consumer_evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "consumer": { "type": "string", "minLength": 1 },
          "declaration_evidence": { "type": "string", "minLength": 1 },
          "provider_evidence": { "type": "string", "minLength": 1 },
          "consumer_evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "consumer", "observation_evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "consumer": { "type": "string", "minLength": 1 },
          "observation_evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
